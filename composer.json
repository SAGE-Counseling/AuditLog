{
    "name": "sage-counseling/audit-log",
    "description": "HIPAA-oriented access-audit logging package for SAGE Counseling apps",
    "type": "library",
    "license": "MIT",
    "keywords": ["sage-counseling", "audit-log", "compliance", "hipaa"],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "SageCounseling\\AuditLog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SageCounseling\\AuditLog\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SageCounseling\\AuditLog\\AuditLogServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
